VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Legacy projects may use VITE_SUPABASE_ANON_KEY instead.
# Never put a Supabase service role key in a VITE_ variable or browser bundle.
# Server-only key for call transcription + summary: https://aistudio.google.com/apikey
# Set this in Vercel environment variables and local .env files used by Vercel dev.
GEMINI_API_KEY=your_gemini_api_key_here
CRM_BUSINESS_CONTEXT=a professional services company

# Optional: PostHog product analytics (leave blank to disable).
# The "phc_" project token is a public/publishable key — safe in the browser.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.posthog.com
